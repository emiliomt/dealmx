# Supabase (supabase start imprime estos valores en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor: firma de NDA (IP) y cron de alertas

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapa (MapLibre GL). URL de un style.json compatible con MapLibre (MapTiler, Stadia, Protomaps, etc.).
# Vacío = mosaicos públicos de OpenStreetMap, SOLO para desarrollo (su política prohíbe uso en producción).
# Los estilos mapbox:// requieren mapbox-gl y NO funcionan con MapLibre.
NEXT_PUBLIC_MAP_STYLE_URL=

# Tipo de cambio para el toggle USD. Si se deja vacío, el toggle se oculta. Fíjalo tú; no se inventa.
NEXT_PUBLIC_FX_USD_MXN=

# Correo / alertas
RESEND_API_KEY=
MAIL_FROM="DealMX <alertas@tu-dominio.mx>"
CRON_SECRET=                          # Vercel Cron lo envía como Authorization: Bearer
